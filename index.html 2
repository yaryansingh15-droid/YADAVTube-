<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YADAVTube - Aesthetic OTT & Creation Studio</title>
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --bg-color: #0d0d11;
            --card-bg: #16161e;
            --card-hover: #1f1f2c;
            --accent-color: #ff0055;
            --accent-gradient: linear-gradient(135deg, #ff0055, #7a00ff);
            --accent-purple: #7a00ff;
            --text-color: #f1f1f1;
            --text-sub: #a0a0b0;
            --border-color: #262635;
            --nav-height: 65px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            padding-bottom: calc(var(--nav-height) + 15px);
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }
        ::-webkit-scrollbar-track {
            background: #0d0d11;
        }
        ::-webkit-scrollbar-thumb {
            background: #333345;
            border-radius: 4px;
        }

        /* Top Header */
        header {
            position: sticky;
            top: 0;
            background-color: rgba(13, 13, 17, 0.95);
            backdrop-filter: blur(12px);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 20px;
            border-bottom: 1px solid var(--border-color);
            z-index: 100;
        }

        .logo {
            font-size: 22px;
            font-weight: 800;
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: flex;
            align-items: center;
            gap: 8px;
            letter-spacing: 0.5px;
        }

        /* Views Layout */
        .tab-content {
            display: none;
            padding: 15px;
            animation: fadeIn 0.25s ease-in-out;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Home View Styling */
        .search-bar {
            display: flex;
            align-items: center;
            background: var(--card-bg);
            padding: 10px 16px;
            border-radius: 24px;
            margin-bottom: 15px;
            border: 1px solid var(--border-color);
            transition: all 0.2s;
        }
        .search-bar:focus-within {
            border-color: #ff0055;
            box-shadow: 0 0 10px rgba(255, 0, 85, 0.2);
        }

        .search-bar input {
            background: transparent;
            border: none;
            color: white;
            width: 100%;
            outline: none;
            margin-left: 10px;
            font-size: 14px;
        }

        .categories {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            margin-bottom: 20px;
            scrollbar-width: none;
            padding-bottom: 4px;
        }

        .category-chip {
            background: var(--card-bg);
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 13px;
            white-space: nowrap;
            border: 1px solid var(--border-color);
            cursor: pointer;
            transition: all 0.2s;
        }

        .category-chip.active {
            background: var(--accent-gradient);
            border-color: transparent;
            font-weight: 600;
        }

        /* Video Cards */
        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 18px;
        }

        .video-card {
            background: var(--card-bg);
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .video-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.4);
        }

        .thumbnail {
            position: relative;
            width: 100%;
            height: 180px;
            background: #1a1a26;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .thumbnail img, .thumbnail video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .thumbnail span.duration {
            position: absolute;
            bottom: 8px;
            right: 8px;
            background: rgba(0, 0, 0, 0.8);
            font-size: 11px;
            padding: 2px 8px;
            border-radius: 6px;
            backdrop-filter: blur(4px);
        }

        .video-details {
            padding: 12px;
            display: flex;
            gap: 12px;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #2a2a3c;
            flex-shrink: 0;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1.5px solid var(--border-color);
        }
        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .meta {
            flex-grow: 1;
            overflow: hidden;
        }

        .meta h4 {
            font-size: 14px;
            font-weight: 600;
            line-height: 1.3;
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .meta p {
            font-size: 12px;
            color: var(--text-sub);
        }

        /* --- 2. INFINITE BOX (SHORTS) --- */
        #infinite-box {
            padding: 0;
        }

        .shorts-container {
            height: calc(100vh - var(--nav-height) - 60px);
            snap-type: y mandatory;
            overflow-y: scroll;
            border-radius: 16px;
            scrollbar-width: none;
        }

        .short-card {
            height: 100%;
            snap-align: start;
            position: relative;
            background: #050508;
            display: flex;
            align-items: flex-end;
            padding: 20px;
            border-radius: 16px;
            margin-bottom: 12px;
            overflow: hidden;
        }

        .short-video-el {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .short-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(0,0,0,0.1) 40%, rgba(0,0,0,0.85) 100%);
            pointer-events: none;
        }

        .short-actions {
            position: absolute;
            right: 15px;
            bottom: 60px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            align-items: center;
            z-index: 10;
        }

        .action-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 22px;
            gap: 4px;
            cursor: pointer;
            text-shadow: 0 2px 4px rgba(0,0,0,0.6);
            transition: transform 0.2s;
        }
        .action-btn:active {
            transform: scale(0.9);
        }

        .action-btn span {
            font-size: 11px;
            color: #d0d0e0;
        }

        .short-info {
            width: 75%;
            z-index: 10;
            margin-bottom: 10px;
        }

        .follow-btn {
            background: var(--accent-gradient);
            border: none;
            color: white;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            margin-left: 8px;
            cursor: pointer;
        }

        /* --- 3. CREATE & EDITORS --- */
        .upload-options {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: 20px;
        }

        .upload-card {
            background: var(--card-bg);
            border: 1.5px dashed var(--accent-color);
            padding: 30px 10px;
            text-align: center;
            border-radius: 16px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .upload-card:hover {
            background: var(--card-hover);
            transform: translateY(-3px);
            border-color: var(--accent-purple);
        }

        .upload-card i {
            font-size: 28px;
            color: var(--accent-color);
            margin-bottom: 10px;
        }

        /* Editor Modal Overlay */
        .editor-modal {
            position: fixed;
            inset: 0;
            background: rgba(10, 10, 15, 0.98);
            z-index: 2000;
            display: none;
            flex-direction: column;
            padding: 16px;
            overflow-y: auto;
        }
        .editor-modal.active {
            display: flex;
        }

        .filter-btn {
            padding: 6px 12px;
            background: #20202e;
            border-radius: 8px;
            font-size: 12px;
            border: 1px solid var(--border-color);
            white-space: nowrap;
            cursor: pointer;
        }
        .filter-btn.active {
            border-color: var(--accent-color);
            background: var(--accent-color);
            color: white;
        }

        /* Bottom Navigation Bar */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: var(--nav-height);
            background-color: #08080c;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-around;
            align-items: center;
            z-index: 1000;
            backdrop-filter: blur(10px);
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: var(--text-sub);
            font-size: 10px;
            text-decoration: none;
            cursor: pointer;
            width: 20%;
            transition: color 0.2s;
        }

        .nav-item i {
            font-size: 19px;
            margin-bottom: 4px;
        }

        .nav-item.active {
            color: var(--accent-color);
        }

        .plus-btn i {
            font-size: 20px;
            background: var(--accent-gradient);
            color: white;
            padding: 10px;
            border-radius: 50%;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(255, 0, 85, 0.5);
            transition: transform 0.2s;
        }
        .plus-btn:active i {
            transform: scale(0.9);
        }

        /* Video Filter Styles */
        .filter-normal { filter: none; }
        .filter-vintage { filter: sepia(0.6) contrast(1.1) brightness(0.9); }
        .filter-bw { filter: grayscale(1); }
        .filter-vivid { filter: saturate(1.8) contrast(1.2); }
        .filter-cool { filter: hue-rotate(180deg) saturate(1.2); }
        .filter-warm { filter: sepia(0.3) saturate(1.4); }

        /* Notification Toast */
        #toast {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%) translateY(-100px);
            background: var(--accent-gradient);
            color: white;
            padding: 10px 24px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 600;
            box-shadow: 0 5px 20px rgba(0,0,0,0.5);
            z-index: 3000;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        #toast.show {
            transform: translateX(-50%) translateY(0);
        }
    </style>
</head>
<body>

    <!-- Notification Toast -->
    <div id="toast">
        <i class="fa-solid fa-circle-check"></i>
        <span id="toast-msg">Action completed!</span>
    </div>

    <!-- Header -->
    <header>
        <div class="logo">
            <i class="fa-solid fa-play"></i> YADAVTube
        </div>
        <div class="flex items-center gap-4 text-lg">
            <i class="fa-solid fa-bell cursor-pointer hover:text-pink-500 transition-colors"></i>
            <i class="fa-solid fa-gear cursor-pointer hover:text-pink-500 transition-colors" onclick="switchTab('profile', document.querySelectorAll('.nav-item')[4])"></i>
        </div>
    </header>

    <!-- MAIN CONTENT AREAS -->

    <!-- Tab 1: HOME PAGE -->
    <div id="home" class="tab-content active">
        <div class="search-bar">
            <i class="fa-solid fa-magnifying-glass" style="color: var(--text-sub);"></i>
            <input type="text" id="searchInput" placeholder="Search videos, creators, posts..." onkeyup="filterHomeContent()">
        </div>
        
        <div class="categories">
            <div class="category-chip active" onclick="selectCategory(this, 'all')">All</div>
            <div class="category-chip" onclick="selectCategory(this, 'trending')">Trending</div>
            <div class="category-chip" onclick="selectCategory(this, 'cricket')">Cricket</div>
            <div class="category-chip" onclick="selectCategory(this, 'music')">Music</div>
            <div class="category-chip" onclick="selectCategory(this, 'tech')">Tech</div>
            <div class="category-chip" onclick="selectCategory(this, 'gaming')">Gaming</div>
        </div>

        <div class="video-grid" id="homeVideoGrid">
            <!-- Default Feed Content -->
            <div class="video-card">
                <div class="thumbnail">
                    <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=600&q=80" alt="Cinematic Art">
                    <span class="duration">12:45</span>
                </div>
                <div class="video-details">
                    <div class="avatar">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80" alt="Avatar">
                    </div>
                    <div class="meta">
                        <h4>Aesthetic Cinematic Vlog - Episode 1</h4>
                        <p>Yadav Productions • 120K views • 2 hours ago</p>
                    </div>
                </div>
            </div>

            <div class="video-card">
                <div class="thumbnail">
                    <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=600&q=80" alt="Tech">
                    <span class="duration">08:15</span>
                </div>
                <div class="video-details">
                    <div class="avatar">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=100&q=80" alt="Avatar">
                    </div>
                    <div class="meta">
                        <h4>Top 10 High Quality Video Streaming Tips</h4>
                        <p>Tech World • 45K views • 1 day ago</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab 2: INFINITE BOX (Shorts View) -->
    <div id="infinite-box" class="tab-content">
        <div class="shorts-container" id="shortsFeedContainer">
            <!-- Feed dynamically generated -->
        </div>
    </div>

    <!-- Tab 3: CREATE OPTION -->
    <div id="create" class="tab-content">
        <div class="max-w-md mx-auto py-4">
            <h2 class="text-2xl font-bold text-center mb-1">Create & Upload Content</h2>
            <p style="color: var(--text-sub);" class="text-xs text-center mb-6">Select content type to upload & edit before publishing</p>

            <div class="upload-options">
                <!-- Video Upload (Longer than 1 min allowed) -->
                <div class="upload-card" onclick="triggerFileUpload('video')">
                    <i class="fa-solid fa-video"></i>
                    <p class="font-semibold text-sm">Full Video</p>
                    <span class="text-[10px] text-gray-400 block mt-1">> 1 min supported</span>
                </div>

                <!-- Short Upload (< 1 min) -->
                <div class="upload-card" onclick="triggerFileUpload('short')">
                    <i class="fa-solid fa-bolt"></i>
                    <p class="font-semibold text-sm">Short Video</p>
                    <span class="text-[10px] text-gray-400 block mt-1">< 60s max</span>
                </div>

                <!-- Photo / Post Upload -->
                <div class="upload-card" onclick="triggerFileUpload('post')">
                    <i class="fa-solid fa-image"></i>
                    <p class="font-semibold text-sm">Photo Post</p>
                    <span class="text-[10px] text-gray-400 block mt-1">Image & Caption</span>
                </div>
            </div>

            <input type="file" id="mediaFileInput" class="hidden" onchange="handleFileSelected(event)">
        </div>
    </div>

    <!-- Tab 4: FOLLOWING -->
    <div id="following" class="tab-content">
        <h3 class="text-lg font-bold mb-4"><i class="fa-solid fa-user-check text-pink-500 mr-2"></i>From Creators You Follow</h3>
        <div class="following-feed flex flex-col gap-4">
            <div class="video-card">
                <div class="thumbnail">
                    <img src="https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=600&q=80" alt="Music Stage">
                    <span class="duration">04:20</span>
                </div>
                <div class="video-details">
                    <div class="avatar">
                        <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=100&q=80" alt="Avatar">
                    </div>
                    <div class="meta">
                        <h4>Exclusive Studio Jam Session - Acoustic Vibes</h4>
                        <p>Aesthetic Official • 10K views • 4 hours ago</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab 5: PROFILE & STUDIO -->
    <div id="profile" class="tab-content">
        <div class="profile-header text-center py-4 border-b border-gray-800 relative">
            <div class="relative w-24 h-24 mx-auto mb-3 group cursor-pointer" onclick="document.getElementById('profilePicInput').click()" title="Click to change profile picture">
                <div class="profile-avatar w-full h-full rounded-full overflow-hidden border-2 border-pink-500 flex items-center justify-center bg-gray-800">
                    <img id="userProfileImg" src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=200&q=80" class="w-full h-full object-cover" alt="User Avatar">
                </div>
                <div class="absolute inset-0 bg-black/50 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                    <i class="fa-solid fa-camera text-white text-xl"></i>
                </div>
            </div>
            <input type="file" id="profilePicInput" accept="image/*" class="hidden" onchange="updateProfilePicture(event)">

            <h2 class="text-xl font-bold" id="profileDisplayName">Yadav Studio</h2>
            <p class="text-xs text-gray-400 mb-2">@yadav_official</p>
            <button class="px-4 py-1.5 rounded-full bg-gray-800 hover:bg-gray-700 text-xs text-white border border-gray-700 transition" onclick="editProfileName()">Edit Profile</button>
        </div>

        <div class="stats-row flex justify-around my-4 bg-gray-900/60 p-3 rounded-xl border border-gray-800">
            <div class="stat-item text-center">
                <h3 class="font-bold text-base text-pink-500" id="statSubscribers">12.4K</h3>
                <p class="text-[11px] text-gray-400">Subscribers</p>
            </div>
            <div class="stat-item text-center">
                <h3 class="font-bold text-base text-pink-500" id="statCreations">0</h3>
                <p class="text-[11px] text-gray-400">Creations</p>
            </div>
            <div class="stat-item text-center">
                <h3 class="font-bold text-base text-pink-500" id="statViews">1.2M</h3>
                <p class="text-[11px] text-gray-400">Total Views</p>
            </div>
        </div>

        <!-- MY CREATIONS SECTION -->
        <div class="mt-6">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-base font-bold flex items-center gap-2">
                    <i class="fa-solid fa-photo-film text-pink-500"></i> My Creations
                </h3>
                <div class="flex gap-1 text-xs bg-gray-900 p-1 rounded-lg border border-gray-800">
                    <button class="px-2.5 py-1 rounded-md active creation-tab-btn" onclick="filterCreations('all', this)">All</button>
                    <button class="px-2.5 py-1 rounded-md creation-tab-btn" onclick="filterCreations('video', this)">Videos</button>
                    <button class="px-2.5 py-1 rounded-md creation-tab-btn" onclick="filterCreations('short', this)">Shorts</button>
                    <button class="px-2.5 py-1 rounded-md creation-tab-btn" onclick="filterCreations('post', this)">Posts</button>
                </div>
            </div>

            <!-- Creations Grid -->
            <div id="myCreationsGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                <!-- Dynamically populated from JavaScript storage -->
            </div>
            <div id="emptyCreationsMsg" class="text-center py-8 text-gray-500 text-sm hidden">
                <i class="fa-solid fa-folder-open text-3xl mb-2 block"></i>
                No uploaded creations yet. Use the '+' button to add content!
            </div>
        </div>
    </div>

    <!-- EDITING MODAL (VIDEO & SHORT EDITOR) -->
    <div id="videoEditorModal" class="editor-modal">
        <div class="flex justify-between items-center mb-4 pb-2 border-b border-gray-800">
            <h3 class="font-bold text-lg flex items-center gap-2">
                <i class="fa-solid fa-wand-magic-sparkles text-pink-500"></i>
                <span id="editorModalTitle">Edit Video</span>
            </h3>
            <button onclick="closeEditorModal()" class="text-gray-400 hover:text-white text-xl"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <!-- Video Preview Container -->
        <div class="relative w-full max-w-lg mx-auto aspect-video bg-black rounded-xl overflow-hidden mb-4 border border-gray-800 flex items-center justify-center">
            <video id="editorVideoPreview" controls class="w-full h-full object-contain filter-normal"></video>
            <div id="editorTextOverlayContainer" class="absolute inset-0 pointer-events-none flex items-center justify-center p-4">
                <span id="editorTextOverlayText" class="text-white font-bold text-xl drop-shadow-md text-center hidden"></span>
            </div>
        </div>

        <!-- Editing Tools Options -->
        <div class="max-w-lg mx-auto w-full space-y-4">
            
            <!-- Filters -->
            <div>
                <label class="text-xs text-gray-400 block mb-1">Visual Filter</label>
                <div class="flex gap-2 overflow-x-auto pb-1">
                    <button class="filter-btn active" onclick="applyVideoFilter('normal', this)">Normal</button>
                    <button class="filter-btn" onclick="applyVideoFilter('vivid', this)">Vivid</button>
                    <button class="filter-btn" onclick="applyVideoFilter('vintage', this)">Vintage</button>
                    <button class="filter-btn" onclick="applyVideoFilter('bw', this)">B&W</button>
                    <button class="filter-btn" onclick="applyVideoFilter('warm', this)">Warm</button>
                    <button class="filter-btn" onclick="applyVideoFilter('cool', this)">Cool</button>
                </div>
            </div>

            <!-- Speed Control -->
            <div>
                <label class="text-xs text-gray-400 block mb-1">Playback Speed</label>
                <div class="grid grid-cols-4 gap-2">
                    <button class="tool-btn bg-gray-800 hover:bg-gray-700 py-1.5 rounded-lg text-xs" onclick="setSpeed(0.5)">0.5x</button>
                    <button class="tool-btn bg-pink-600 py-1.5 rounded-lg text-xs font-semibold" onclick="setSpeed(1.0)">1.0x (Normal)</button>
                    <button class="tool-btn bg-gray-800 hover:bg-gray-700 py-1.5 rounded-lg text-xs" onclick="setSpeed(1.5)">1.5x</button>
                    <button class="tool-btn bg-gray-800 hover:bg-gray-700 py-1.5 rounded-lg text-xs" onclick="setSpeed(2.0)">2.0x</button>
                </div>
            </div>

            <!-- Audio Overlay -->
            <div>
                <label class="text-xs text-gray-400 block mb-1">Background Audio Track</label>
