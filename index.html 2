    <!-- Application State & Interactive Scripts -->
    <script>
        // State Storage
        let creationsState = JSON.parse(localStorage.getItem('yadavtube_creations')) || [];
        let currentUploadType = null; // 'video', 'short', 'post'
        let currentMediaData = null;
