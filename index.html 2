        // Notification Toast Helper
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = message;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3000);
        }

        // Upload Trigger Functionality
        function triggerFileUpload(type) {
            currentUploadType = type;
            const fileInput = document.getElementById('mediaFileInput');
            if (type === 'post') {
                fileInput.accept = 'image/*';
            } else {
                fileInput.accept = 'video/*';
            }
            fileInput.click();
        }

        // Handling File Upload and Routing to Editor
        function handleFileSelected(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                currentMediaData = e.target.result;

                if (currentUploadType === 'post') {
                    // Open Photo Editor
                    document.getElementById('editorPhotoPreview').src = currentMediaData;
                    document.getElementById('editorPhotoCaptionInput').value = '';
                    document.getElementById('editorPhotoTextInput').value = '';
                    document.getElementById('editorPhotoTextOverlay').classList.add('hidden');
                    document.getElementById('photoEditorModal').classList.add('active');
                } else {
                    // Open Video Editor (For Video or Short)
                    const videoEl = document.getElementById('editorVideoPreview');
                    videoEl.src = currentMediaData;
                    document.getElementById('editorTitleInput').value = '';
                    document.getElementById('editorTextInput').value = '';
                    document.getElementById('editorTextOverlayText').classList.add('hidden');
                    document.getElementById('editorModalTitle').innerText = currentUploadType === 'short' ? 'Edit Short Video (<60s)' : 'Edit Full Video';
                    document.getElementById('videoEditorModal').classList.add('active');
                }
            };
            reader.readAsDataURL(file);
            event.target.value = ''; // Reset input
        }

        // Close Editor Modals
        function closeEditorModal() {
            document.getElementById('videoEditorModal').classList.remove('active');
            document.getElementById('photoEditorModal').classList.remove('active');
            const videoPreview = document.getElementById('editorVideoPreview');
            videoPreview.pause();
            videoPreview.src = '';
        }

        // Video Filter Application
        function applyVideoFilter(filterName, btnEl) {
            const videoPreview = document.getElementById('editorVideoPreview');
            videoPreview.className = `w-full h-full object-contain filter-${filterName}`;
            selectedFilter = filterName;
            btnEl.parentElement.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btnEl.classList.add('active');
        }

        // Photo Filter Application
        function applyPhotoFilter(filterName, btnEl) {
            const photoPreview = document.getElementById('editorPhotoPreview');
            photoPreview.className = `max-w-full max-h-full object-contain filter-${filterName}`;
            selectedFilter = filterName;
            btnEl.parentElement.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btnEl.classList.add('active');
        }

        // Speed Control
        function setSpeed(speed) {
            const videoPreview = document.getElementById('editorVideoPreview');
            videoPreview.playbackRate = speed;
            showToast(`Playback speed set to ${speed}x`);
        }

        // Text Overlay Live Preview
        function updateTextOverlay(text) {
            const overlayText = document.getElementById('editorTextOverlayText');
            if (text.trim()) {
                overlayText.innerText = text;
                overlayText.classList.remove('hidden');
            } else {
                overlayText.classList.add('hidden');
            }
        }

        function updatePhotoTextOverlay(text) {
            const overlayText = document.getElementById('editorPhotoTextOverlay');
            if (text.trim()) {
                overlayText.innerText = text;
                overlayText.classList.remove('hidden');
            } else {
                overlayText.classList.add('hidden');
            }
        }

        // PUBLISH MEDIA TO CREATIONS & FEEDS
        function publishMediaContent() {
            let title = '';
            let filter = selectedFilter;

            if (currentUploadType === 'post') {
                title = document.getElementById('editorPhotoCaptionInput').value.trim() || 'Untitled Post';
            } else {
                title = document.getElementById('editorTitleInput').value.trim() || 'Untitled Video';
            }

            const newCreation = {
                id: 'creation_' + Date.now(),
                type: currentUploadType,
                title: title,
                mediaUrl: currentMediaData,
                filter: filter,
                timestamp: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
                views: '0 views',
                likes: 0
            };

            // Add to state & localstorage
            creationsState.unshift(newCreation);
            localStorage.setItem('yadavtube_creations', JSON.stringify(creationsState));

            // UI Updates
            closeEditorModal();
            renderMyCreations();
            updateCreationsCount();

            if (currentUploadType === 'short') {
                renderInfiniteBoxShorts();
                showToast('Short published to Infinite Box!');
                switchTab('infinite-box', document.querySelectorAll('.nav-item')[1]);
            } else if (currentUploadType === 'video') {
                addVideoToHomeFeed(newCreation);
                showToast('Video published to Home Feed!');
                switchTab('home', document.querySelectorAll('.nav-item')[0]);
            } else {
                showToast('Photo post published!');
                switchTab('profile', document.querySelectorAll('.nav-item')[4]);
            }
        }

        // RENDER CREATIONS IN PROFILE
        function renderMyCreations(filterType = 'all') {
            const grid = document.getElementById('myCreationsGrid');
            const emptyMsg = document.getElementById('emptyCreationsMsg');
            grid.innerHTML = '';

            const itemsToDisplay = creationsState.filter(item => filterType === 'all' || item.type === filterType);

            if (itemsToDisplay.length === 0) {
                emptyMsg.classList.remove('hidden');
                return;
            } else {
                emptyMsg.classList.add('hidden');
            }

            itemsToDisplay.forEach(item => {
                const card = document.createElement('div');
                card.className = 'bg-gray-900 rounded-xl overflow-hidden border border-gray-800 relative group';
                
                let mediaElement = '';
                if (item.type === 'post') {
                    mediaElement = `<img src="${item.mediaUrl}" class="w-full h-32 object-cover filter-${item.filter}">`;
                } else {
                    mediaElement = `<video src="${item.mediaUrl}" class="w-full h-32 object-cover filter-${item.filter}"></video>`;
                }

                card.innerHTML = `
                    <div class="relative">
                        ${mediaElement}
                        <span class="absolute top-2 left-2 text-[10px] uppercase font-bold bg-black/70 px-2 py-0.5 rounded text-pink-400 border border-pink-500/30">
