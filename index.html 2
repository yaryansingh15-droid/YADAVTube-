                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filterCreations(type, btn) {
            document.querySelectorAll('.creation-tab-btn').forEach(b => b.classList.remove('active', 'bg-pink-600', 'text-white'));
            btn.classList.add('active', 'bg-pink-600', 'text-white');
            renderMyCreations(type);
        }

        function deleteCreation(id, e) {
            e.stopPropagation();
            creationsState = creationsState.filter(item => item.id !== id);
            localStorage.setItem('yadavtube_creations', JSON.stringify(creationsState));
            renderMyCreations();
            renderInfiniteBoxShorts();
            updateCreationsCount();
            showToast('Item deleted successfully');
        }

        function updateCreationsCount() {
            document.getElementById('statCreations').innerText = creationsState.length;
        }

        // RENDER INFINITE BOX SHORTS
        function renderInfiniteBoxShorts() {
            const container = document.getElementById('shortsFeedContainer');
            container.innerHTML = '';

            const uploadedShorts = creationsState.filter(c => c.type === 'short').map(c => ({
                id: c.id,
